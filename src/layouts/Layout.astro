---
import "../styles/global.css";
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="generator" content={Astro.generator} />
    <title>Ashly - Asistente Virtual IA &amp; VTuber Inteligente Local</title>
    <!-- Google Fonts: Sora, Inter & JetBrains Mono -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500;600&family=Sora:wght@400;600;700;800&display=swap"
      rel="stylesheet"
    />

    <!-- Anti-FOUC (Previene parpadeo y efecto de recarga antes de GSAP) -->
    <script is:inline>
      document.documentElement.classList.add('gsap-loading');
    </script>
    <style is:inline>
      /* Evita que Nav y Hero se pinten visibles antes de que GSAP tome control */
      html.gsap-loading #main-header {
        opacity: 0;
        transform: translateY(-40px);
      }
      html.gsap-loading .hero-badge,
      html.gsap-loading .hero-word,
      html.gsap-loading .hero-desc,
      html.gsap-loading .hero-badge-item,
      html.gsap-loading .hero-cta-btn,
      html.gsap-loading .hero-subtext {
        opacity: 0;
      }
      html.gsap-loading .hero-word {
        transform: translateY(35px);
        filter: blur(8px);
      }
    </style>
  </head>
  <body
    class="bg-ashly-bg text-slate-100 font-sans antialiased selection:bg-ashly-cyan selection:text-black min-h-screen relative overflow-x-hidden"
  >
    <!-- Canvas interactivo global: Matriz de puntos y difuminado dinámico con cursor -->
    <canvas
      id="global-dot-canvas"
      class="fixed inset-0 pointer-events-none z-0 w-full h-full"></canvas>

    <div class="relative z-10 flex flex-col min-h-screen">
      <slot />
    </div>

    <!-- Script Central de Animaciones GSAP, ScrollTrigger, Lenis y Canvas -->
    <script src="../assets/animaciones-gsap/animations.js"></script>
  </body>
</html>
