          <span class="">📑</span> Actividad (Protegido)
        </button>
        <button
          class="px-3 py-1.5 rounded-t-lg bg-[#081226] text-slate-400 hover:text-white flex items-center gap-1.5 border-t border-x border-transparent"
        >
          <span class="">🎭</span> Monitor Emocional (Dev)
        </button>
      </div>
      <!-- Warning / Protected Banner (Exact match to Image 2 golden box) -->
      <div class="p-4 bg-[#040816]">
        <div
          class="bg-[#241c03]/85 border border-amber-500/40 rounded-lg p-3 text-center text-amber-200 shadow-md mb-4"
        >
          <div
            class="font-sora font-bold text-xs uppercase tracking-wide flex items-center justify-center gap-1.5 text-amber-300"
          >
            <span class="">🔒</span> REGISTRO PROTEGIDO DE SOLO LECTURA
          </div><p class="text-xs text-amber-200/90 mt-0.5 font-sans">
            El registro de auditoría de actividad del sistema no se puede
            modificar ni borrar para preservar la seguridad.
          </p>
        </div><div
