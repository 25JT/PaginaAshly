<section class="py-20 bg-[#02050e] relative overflow-hidden" id="auditoria">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-3xl mx-auto mb-12">
      <span
        class="text-xs font-mono text-amber-400 uppercase tracking-widest px-3 py-1 rounded-full bg-amber-950/40 border border-amber-500/30"
        >Seguridad &amp; Transparencia Absoluta</span
      >
      <h2 class="text-3xl sm:text-4xl font-sora font-extrabold text-white mt-3">
        Registro de Auditoría de Solo Lectura
      </h2>
      <p class="text-slate-400 text-sm sm:text-base mt-2">
        Cada acción, filtro de intención y ejecución de programas se audita en
        una base inmutable. Sabrás exactamente qué comandos y herramientas
        ejecutó el Planner.
      </p>
    </div>
    <!-- Software Window Mockup: Gestor de Memoria (Image 2 Replica) -->
    <div
      class="rounded-xl border border-cyan-900/60 bg-[#030612] shadow-window overflow-hidden"
    >
      <!-- Window Title Bar -->
      <div
        class="bg-[#001b30] px-4 py-2 border-b border-cyan-900/80 flex items-center justify-between select-none"
      >
        <div class="flex items-center gap-2">
          <span
            class="w-4 h-4 rounded-full overflow-hidden inline-block border border-cyan-400/50 shadow-[0_0_8px_rgba(23,184,254,0.4)]"
            ><img
              alt="Ashly Icon"
              class="w-full h-full object-cover"
              src="https://lh3.googleusercontent.com/aida-public/AB6AXuCqqxl5JuJ7lzUQezHqE7Y7ezMWbJ0ponq1pLx6d9xJUoxWPUSKshakRFmLeoAYpdEY5eY7LZ7B1JTcVPLrgXQqWmXMZswCjD_m5cY2yrX8TL9ioIX3iWGORpdhBI8u8Mk-I0_9nHuGWCHwHTGWVxcTXdQMwghRLb9RmphsramI8I5OmCzn1-G9CWwOrDRdOtQxHUBcGatq5beUFpiDGssmAFfhxBc_gud55eqakqCv-IVXdwoa5_MTGZ1PI2ufyd_zvSk"
            /></span
          >
          <span
            class="text-xs font-mono text-cyan-200 font-semibold tracking-wider"
            >Ashly 3.0 - Gestión de Memoria</span
          >
        </div>
        <div class="flex items-center gap-2.5 text-slate-400 text-xs font-mono">
          <span class="hover:text-white cursor-pointer px-1">─</span>
          <span class="hover:text-white cursor-pointer px-1">□</span>
          <span class="hover:text-red-400 cursor-pointer px-1">✕</span>
        </div>
      </div>
      <!-- Upper Tabs Navigation (recreation of Historial, Aprendizajes, Actividad, Monitor) -->
      <div
        class="bg-[#050b18] px-4 pt-3 border-b border-cyan-950 flex flex-wrap items-center gap-2 select-none text-xs"
      >
        <button
          class="px-3 py-1.5 rounded-t-lg bg-[#081226] text-slate-400 hover:text-white flex items-center gap-1.5 border-t border-x border-transparent"
        >
          <span class="">💬</span> Historial
        </button>
        <button
          class="px-3 py-1.5 rounded-t-lg bg-[#081226] text-slate-400 hover:text-white flex items-center gap-1.5 border-t border-x border-transparent"
        >
          <span class="">💡</span> Aprendizajes
        </button>
        <button
          class="px-3 py-1.5 rounded-t-lg bg-[#081b33] text-cyan-300 font-medium flex items-center gap-1.5 border-t-2 border-t-ashly-cyan border-x border-cyan-900/80"
