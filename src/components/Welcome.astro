<section class="py-20 bg-[#040714] border-t border-slate-900" id="capacidades">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-2xl mx-auto mb-16">
      <span
        class="text-xs font-mono text-ashly-cyan uppercase tracking-widest px-3 py-1 rounded-full bg-cyan-950/60 border border-cyan-800/40"
        >Arquitectura Híbrida</span
      >
      <h2 class="text-3xl sm:text-4xl font-sora font-extrabold text-white mt-3">
        Por qué Ashly supera a los bots web
      </h2>
    </div>
