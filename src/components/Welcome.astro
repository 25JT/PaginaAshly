<section
  class="py-20 bg-[#030611] border-y border-ashly-border relative"
  id="interfaz"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-3xl mx-auto mb-16">
      <span
        class="text-xs font-mono text-ashly-cyan uppercase tracking-widest px-3 py-1 rounded-full bg-cyan-950/60 border border-cyan-800/40"
        >Fidelidad visual nativa</span
      >
      <h2 class="text-3xl sm:text-4xl font-sora font-extrabold text-white mt-3">
        Diseñada para trabajar en tu escritorio, no en una pestaña
      </h2>
      <p class="text-slate-400 text-sm sm:text-base mt-2">
        Explora los módulos exactos del software cliente que controlan modelos
        locales, memoria a largo plazo y automatizaciones del sistema operativo.
      </p>
    </div>
    <!-- Grid of 3 Windows Recreated directly from App Screenshots -->
    <div
      class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 items-start"
    >
      <!-- CARD 1: Configuración & Modelos (Image 3) -->
      <!-- This container displays the Configuration and Model Switcher exactly as seen in Image 3 -->
      <div
        class="bg-[#05091b] rounded-2xl border border-ashly-border overflow-hidden shadow-window transition-all duration-300 hover:border-cyan-500/50 flex flex-col"
      >
        <div
          class="bg-[#020f1e] px-4 py-2.5 border-b border-cyan-950 flex items-center justify-between"
        >
          <span
            class="text-xs font-mono text-cyan-300 font-semibold flex items-center gap-1.5"
          >
            <span class="">⚙️</span> Configuración del Asistente
          </span>
          <span class="text-[10px] text-slate-400 font-mono">MODO: HÍBRIDO</span
          >
        </div>
        <div class="p-5 flex-1 flex flex-col justify-between space-y-4">
          <!-- Ashly Asistente IA status header -->
          <div
            class="flex items-center justify-center gap-2 font-sora font-bold text-lg text-white"
          >
            <span
              class="w-3 h-3 rounded-full bg-emerald-400 shadow-[0_0_8px_#34d399]"
            ></span>
            <h3 class="">Ashly Asistente IA</h3>
          </div>
          <!-- Active Model Card -->
          <div
            class="bg-[#040817] border border-cyan-900/60 rounded-xl p-3 text-center"
          >
            <div
              class="text-xs text-purple-400 font-medium flex items-center justify-center gap-1"
            >
              <span class="">🤖</span> Modelo Activo
            </div>
            <div class="text-xs font-mono text-purple-200 mt-1 font-semibold">
              Google Gemini (gemini-3.5-flash-lite)
            </div>
          </div>
          <!-- Configuration Action Buttons (exact copy of Screenshot 3) -->
          <div class="space-y-2.5">
            <!-- Cambiar a Modelo Local -->
            <button
              class="w-full py-2.5 px-4 rounded-xl bg-[#3b1d6e] hover:bg-[#4c1d95] text-white text-xs font-semibold flex items-center gap-2.5 border border-purple-500/40 shadow-sm transition-all"
            >
              <span class="text-base">💻</span>
              <span class="">Cambiar a Modelo Local</span>
            </button>
            <!-- Gestión de Memoria -->
            <button
              class="w-full py-2.5 px-4 rounded-xl bg-[#09152b] hover:bg-[#0c1f3d] text-white text-xs font-medium flex items-center gap-2.5 border border-cyan-900/80 transition-all"
            >
              <span class="text-base">🧠</span>
              <span class="">Gestión de Memoria</span>
            </button>
            <!-- Cambiar Avatar -->
            <button
              class="w-full py-2.5 px-4 rounded-xl bg-[#09152b] hover:bg-[#0c1f3d] text-white text-xs font-medium flex items-center gap-2.5 border border-cyan-900/80 transition-all"
            >
              <span class="text-base">👤</span>
              <span class="">Cambiar Avatar...</span>
            </button>
            <!-- Salir button -->
            <button
              class="w-full py-2.5 px-4 rounded-xl bg-[#130d1d] hover:bg-[#200f1c] text-rose-300 text-xs font-medium flex items-center gap-2.5 border border-rose-900/40 transition-all"
            >
              <span class="text-base">✕</span>
              <span class="">Salir</span>
            </button>
          </div>
          <div
            class="pt-2 text-[11px] text-slate-400 border-t border-slate-800"
          >
            * Cambia dinámicamente entre API ultrarrápida y ejecución local sin
            desconectar el estado de la conversación.
          </div>
        </div>
      </div>
      <!-- CARD 2: Chat & Historial de Sesiones (Image 4) -->
      <!-- Faithful reproduction of the Chat Timeline & Session Tabs -->
      <div
        class="bg-[#05091b] rounded-2xl border border-ashly-border overflow-hidden shadow-window transition-all duration-300 hover:border-cyan-500/50 flex flex-col"
      >
        <div
          class="bg-[#020f1e] px-4 py-2.5 border-b border-cyan-950 flex items-center justify-between"
        >
          <span
            class="text-xs font-mono text-cyan-300 font-semibold flex items-center gap-1.5"
          >
            <span class="">💬</span> Historial y Sesiones
          </span>
          <span class="text-[10px] text-slate-400 font-mono">10 EVENTOS</span>
        </div>
        <div class="p-5 flex-1 flex flex-col justify-between space-y-4">
          <div class="flex flex-col items-center justify-center">
            <img
              src="https://lh3.googleusercontent.com/aida-public/AB6AXuCQg6U6-j2oZ7PhQResVFjhwltWHstf4ELk_RaBXn1gIdbR5XRwU202ojmc9JZDEpnZV92fHeo5zwZ7Dg1XGvriRgY4zkAr4x8X0ze0CzCuEuP_kXH0w_wGEmJok8y_mbb7AAFNAn2RbYl35_4Mz0CKrtPGLCcmajsDPPszAPgsfQz8Xe2lwi0C_me-oK6g-2vE-vklSL144dPS12iA5C3PdkGXqMiBXXRwcj9ES_EdqKGIqgStwyk3-o2CfYGsZVHWDvM"
              alt="Historial y Sesiones - Chat en vivo"
              class="w-full max-h-[320px] object-contain rounded-xl shadow-lg border border-cyan-900/40 hover:border-cyan-500/50 transition-all"
            />
          </div><div class="text-[11px] text-slate-400 mt-2">
            * Detección de intenciones inmediata: la IA interpreta lenguaje
            natural y lo traduce a llamadas de API del sistema.
          </div>
        </div>
      </div>
      <!-- CARD 3: Interfaz del Avatar 3D (Image 5) -->
      <!-- Container for Live VTuber / 3D Canvas visualizer -->
      <div
        class="bg-[#05091b] rounded-2xl border border-ashly-border overflow-hidden shadow-window transition-all duration-300 hover:border-cyan-500/50 flex flex-col"
      >
        <div
          class="bg-[#020f1e] px-4 py-2.5 border-b border-cyan-950 flex items-center justify-between"
        >
          <span
            class="text-xs font-mono text-cyan-300 font-semibold flex items-center gap-1.5"
          >
            <span class="">👤</span> Visor de Avatar 3D VRM
          </span>
          <span class="text-[10px] text-emerald-400 font-mono"
            >TRACKING ACTIVO</span
          >
        </div>
        <div
          class="p-5 flex-1 flex flex-col items-center justify-between space-y-4 dot-matrix-dense"
        >
          <div class="relative w-full flex justify-center py-2">
            <img
              alt="Ashly Avatar Model View"
              class="h-64 object-contain rounded-lg drop-shadow-[0_15px_25px_rgba(0,0,0,0.9)]"
              src="https://lh3.googleusercontent.com/aida-public/AB6AXuCukvbWEC8b97lzoKMbPVamsw8vmCnY9EgVCaFHkec2jNjnSILS4wDTCwizwv6IJPgSMqI8YEQrkDXutskmwx3r22lri54_cNORztRSfb4AsPjwrq7Ftz_o6eKuFjkhQUgo0HUHA1jOivjtW6BlKDb--0u-qCWegQBroF--v7LiNdMhfT9u2OcUSh3or89TvLGYQHT9mViXXcNjWCqBvjvMgNMoM-YeEbM0Vp5LAPSEpBIs5y-_bENeKBOeZiSnOl9PSYo"
            />
          </div>

          <div class="w-full text-[11px] text-slate-400 text-center">
            Reacciones basadas en el estado emocional computado en cada
            respuesta (Neutro, Alegría, Sorpresa, Pensativo).
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
<!-- END: FeatureWindowsGallery -->
