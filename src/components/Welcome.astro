<section
  class="relative pt-12 pb-20 md:pt-20 md:pb-32 overflow-hidden dot-matrix-bg"
>
  <!-- Ambient glow orbs -->
  <div
    class="absolute top-1/4 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[350px] bg-sky-600/10 blur-[130px] rounded-full pointer-events-none"
  >
  </div>
  <div
    class="absolute top-1/3 right-10 w-[300px] h-[300px] bg-purple-600/15 blur-[120px] rounded-full pointer-events-none"
  >
  </div>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
      <!-- Left Hero Content -->
      <div class="lg:col-span-6 space-y-6 text-center lg:text-left">
        <div
          class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-slate-900/90 border border-ashly-cyan/40 text-xs text-ashly-cyan font-mono shadow-sm"
        >
          <span class="w-2 h-2 rounded-full bg-ashly-cyan animate-ping"></span>
          ASISTENTE VIRTUAL IA CON PRESENCIA 3D &amp; AUTOMATIZACIÓN LOCAL
        </div>
        <h1
          class="text-4xl sm:text-5xl lg:text-6xl font-sora font-extrabold text-white tracking-tight leading-[1.12]"
        >
          Tu compañera inteligente que <span
            class="bg-gradient-to-r from-ashly-cyan via-sky-400 to-purple-400 bg-clip-text text-transparent"
            >realmente opera</span
          > tu ordenador.
        </h1>
        <p
          class="text-base sm:text-lg text-slate-300 max-w-xl mx-auto lg:mx-0 leading-relaxed font-light"
        >
          Ejecuta herramientas nativas en bucle, abre software, recuerda tus
          proyectos y reacciona emocionalmente en tiempo real mediante su avatar
          3D interactivo. Conmutable al instante entre <strong
            class="text-white font-medium">Google Gemini Flash-Lite</strong
          > y <strong class="text-white font-medium">Modelos Locales</strong> sin
          censura ni pérdida de privacidad.
        </p>
        <!-- System Badges Feature -->
        <div
          class="flex flex-wrap items-center justify-center lg:justify-start gap-2 pt-2 text-xs font-mono"
        >
          <span
            class="px-2.5 py-1 rounded bg-[#0b132b] text-sky-300 border border-sky-800/60 flex items-center gap-1.5"
          >
            🤖 Gemini 3.5 Flash-Lite
          </span>
          <span
            class="px-2.5 py-1 rounded bg-[#1c0e35] text-purple-300 border border-purple-800/60 flex items-center gap-1.5"
          >
            💻 Modo Local (Ollama / GGUF)
          </span>
          <span
            class="px-2.5 py-1 rounded bg-[#08221b] text-emerald-300 border border-emerald-800/60 flex items-center gap-1.5"
          >
            🛡️ Auditoría Inmutable
          </span>
        </div>
        <!-- CTAs -->
        <div
          class="pt-4 flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-4"
        >
          <a
            class="w-full sm:w-auto px-7 py-3.5 rounded-xl bg-gradient-to-r from-ashly-cyan to-blue-600 hover:from-sky-300 hover:to-blue-500 text-slate-950 font-bold font-sora text-sm flex items-center justify-center gap-3 shadow-[0_0_25px_rgba(23,184,254,0.4)] transition-all transform hover:-translate-y-0.5"
            href="#descarga"
          >
            <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24"
              ><path
                d="M0 3.449L9.75 2.1v9.451H0m10.949-9.602L24 0v11.4H10.949M0 12.6h9.75v9.451L0 20.699M10.949 12.6H24V24l-13.051-1.802"
              ></path></svg
            >
            <span class="">Descargar Ashly 3.0 para Windows</span>
          </a>
        </div>
        <p class="text-xs text-slate-400 font-mono">
          Versión 3.0.4 • 64-bit • Sin telemetría oculta
        </p>
      </div>
      <!-- Right Hero Mockup: Dual View of Ashly Real App -->
      <div class="lg:col-span-6">
        <div class="relative mx-auto max-w-lg lg:max-w-none">
          <!-- Main Application Window Wrapper -->
          <div
            class="rounded-2xl bg-[#030611] border border-cyan-500/40 shadow-window overflow-hidden"
          >
            <!-- Windows OS Title Bar -->
            <div
              class="bg-[#001728] px-3.5 py-2 border-b border-cyan-900/50 flex items-center justify-between select-none"
            >
              <div class="flex items-center gap-2">
                <span
                  class="w-4 h-4 rounded-full overflow-hidden inline-block border border-cyan-400/50 shadow-[0_0_8px_rgba(23,184,254,0.4)]"
                  ><img
                    alt="Ashly Icon"
                    class="w-full h-full object-cover"
                    src="https://lh3.googleusercontent.com/aida-public/AB6AXuBedXJpKjugcyLa9PRuy1Pt17y7X8TEPOi1doGu8WzjHz6JjsYhiRd_qKFPI2V_elfe0JeRN2RK7wi9OBNnakXbvC4RyIpTEJYs3owPntJraT_JrA1zJdnTQ2xx1dtEc0mXz-jmYhhra_aLTk-263WvYyAQcr-7DnN6q7dXixOFPtUzhg0sECah6B-5yBjvRrsDR5FmW81iOAiipMsbQ2mznK0dFeoLj2mq-6xI0FiVABmOf7TXzunGgTdy3B8LxvRCVLs"
                  /></span
                >
                <span class="text-xs font-mono text-cyan-200 tracking-wide"
                  >Ashly 3.0 - Asistente &amp; VTuber Desktop&nbsp; AGREGAR
                  ANIAMACION DE SALUDO</span
                >
              </div>
            </div>
            <!-- Software Content Frame -->
            <div
              class="grid grid-cols-1 sm:grid-cols-2 divide-y sm:divide-y-0 sm:divide-x divide-slate-800/80 bg-[#050814]"
            >
              <!-- Left Sub-view: Real 3D Avatar (Image 5) -->
              <div
                class="relative flex flex-col items-center justify-between p-3 dot-matrix-dense min-h-[380px]"
              >
                <div
                  class="w-full flex items-center justify-between text-[11px] font-mono text-cyan-400 px-1"
                >
                </div>
                <!-- 3D Avatar Viewport -->
                <div class="my-auto relative flex items-center justify-center">
                  <img
                    alt="Ashly Avatar 3D interactivo"
                    class="max-h-[290px] w-auto object-contain rounded-lg drop-shadow-[0_10px_20px_rgba(0,0,0,0.8)] filter brightness-105"
                    src="https://lh3.googleusercontent.com/aida-public/AB6AXuAPZlyYaAvD26XVflMbC4KWzJbUghWTsNngfWik2QlWZ7qhR9MC_R1o9xJLMFH1lld14L9SLyqMhAknb6YtBeFQACAfpI53Ouw7_4H0LE_Mlo-WUruZS5QYL2Ig8uQmnQgjv0ZufFd_niiYR2bZSYL3Cs9wcgG4LvqoliAObX-4cn2fqFR1mFo1nbKIHH2BBW48PZgJyWfKZ7sXXwBrN_dWbPV2ngEOF0q2As3IaTjbIWcm_5-GuHQk3V0DU0evQME-Ql4"
                  />
                </div>
                <!-- Chat quick prompt inside viewport -->
                <div class="w-full">
                  <div
                    class="w-full bg-[#031326]/90 border border-cyan-500/40 rounded-full px-3.5 py-1.5 flex items-center justify-between shadow-inner"
                  >
                    <span class="text-xs text-slate-400 font-mono"
                      >Escribe aquí...</span
                    >
                    <svg
                      class="w-3.5 h-3.5 text-ashly-cyan fill-current"
                      viewBox="0 0 24 24"
                      ><path d="M2.01 21L23 12 2.01 3 2 10l15 2-15 2z"
                      ></path></svg
                    >
                  </div>
                </div>
              </div>
              <!-- Right Sub-view: Active Chat Execution (Image 4 exact recreation) -->
              <div
                class="flex flex-col items-center justify-center bg-[#040816] p-2 overflow-hidden"
              >
                <img
                  src="https://lh3.googleusercontent.com/aida-public/AB6AXuA6f5uB0CWIsO-6k8QltZDPskahS1eGn227-6gcCoFtbJFA0FjAbVm5lYoQdWkKfmcSza8iXrKzaPdRHtyETgGM73Ae6n3LoQamYUNp8i59Bz8kE67rtjj_gQSMHyrjmpZbmttvfb2kUJl-C81777j48cGHDCbrieFdLtpnjyAigYV7arcTjL_Kqzb69W6RItlf1IU4eU4A1XC8B4G9ulrrnat2OWg0VshNqCCfld5F_JMQ48hlL5qFjwDy4UE4kEPvbqM"
                  alt="Ashly Chat y Sesiones en Vivo"
                  class="max-h-[380px] w-auto object-contain rounded-lg shadow-lg border border-cyan-900/40 filter brightness-105"
                />
              </div>
            </div>
            <!-- Software Bottom Navigation Bar (recreated from Image 3 & 4) -->
          </div>
          <!-- Floating feature tag -->
        </div>
      </div>
    </div>
  </div>
</section>
<!-- END: HeroSection -->
