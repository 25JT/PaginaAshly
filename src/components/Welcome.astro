                  ><th
                    class="py-2.5 px-4 w-44 text-cyan-300 font-semibold border-r border-cyan-950"
                    >Timestamp</th
                  ><th
                    class="py-2.5 px-4 w-48 text-cyan-300 font-semibold border-r border-cyan-950"
                    >Tipo Evento</th
                  ><th
